# Copy this file to .env and fill in real values before running the site.

# Port the server listens on
PORT=3000

# Long random string used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Set to "true" only once the site is deployed behind real HTTPS (e.g. via a reverse proxy
# like Caddy or Nginx with a certificate). Keep it unset/false for local development.
FORCE_HTTPS=false
